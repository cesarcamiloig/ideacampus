# ==========================================
# Configuración del Proyecto
# ==========================================
ENVIRONMENT=development

# ==========================================
# Base de Datos (MySQL 8.4 LTS)
# ==========================================
# Credenciales utilizadas por Docker y Django

# Opción A: Base de datos local en contenedor Docker
#DB_HOST=db
#DB_PORT=3306
#DB_NAME=ideacampus
#DB_USER=usuario
#DB_PASSWORD=ingresa_aqui_tu_password_local
#DB_ROOT_PASSWORD=ingresa_aqui_tu_password_root

# Opción B: Base de datos compartida en la nube (TiDB Cloud Serverless / MySQL Cloud)
# TiDB Cloud Starter es gratuito, sin tarjeta y con 5 GiB perpetuos.
DB_NAME=ideacampus
DB_USER=ingresa_aqui_el_usuario_de_tidb
DB_PASSWORD=ingresa_aqui_el_password_de_tidb
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_SSL=True

# Opción C: Conexión directa mediante DATABASE_URL (Cloud)
#DATABASE_URL=mysql://user:password@gateway01.us-east-1.prod.aws.tidbcloud.com:4000/ideacampus?ssl_mode=REQUIRED

# ==========================================
# Backend (Django)
# ==========================================
DJANGO_SECRET_KEY=ingresa_una_llave_secreta_local_para_django
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
JWT_KEY=ingresa_una_llave_secreta_local_para_jwt_minimo_32_bytes

# ==========================================
# Autenticación (Google Workspace UFPS - RF01)
# ==========================================
# Credenciales de Google Cloud Console para el inicio de sesión
GOOGLE_CLIENT_ID=tu_client_id_institucional.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret_institucional

# ==========================================
# Frontend (React / Vite)
# ==========================================
# URL base para que React se comunique con el API de Django
VITE_API_URL=http://localhost:8000/api